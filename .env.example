# ============================================================
# Dimed Salary — muhit o'zgaruvchilari (.env)
# Ushbu faylni ".env" deb nusxalang va qiymatlarni to'ldiring.
# ============================================================

# --- Supabase ulanishi ---
# Supabase loyihangiz Settings -> API bo'limidan oling.
# Bo'sh qoldirilsa — ilova DEMO rejimda (localStorage) ishlaydi.
# Sozlansa — kirish faqat Supabase Auth (email+parol, 'staff' roli) orqali
# bo'ladi (README -> Xavfsizlik).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase Storage (IVMS agent yuklaydigan bucket nomi) ---
VITE_IVMS_BUCKET=ivms-reports

# --- Faqat DEMO rejim uchun (Supabase sozlanmagan bo'lsa) ---
# Format: nickname:parol,nickname:parol,... Bo'sh bo'lsa: admin/admin.
# Real rejimda ishlatilmaydi — Netlify ga qo'shmang.
VITE_USERS=
