# ============================================================
# Dimed Salary — muhit o'zgaruvchilari (.env)
# Ushbu faylni ".env" deb nusxalang va qiymatlarni to'ldiring.
# ============================================================

# --- Foydalanuvchilar (custom login) ---
# Format: nickname:parol,nickname:parol,...
# 3 ta foydalanuvchi (admin, buxgalter, direktor)
VITE_USERS=admin:parol1,buxgalter:parol2,direktor:parol3

# --- Supabase ulanishi ---
# Supabase loyihangiz Settings -> API bo'limidan oling.
# Bo'sh qoldirilsa — ilova DEMO rejimda (localStorage) ishlaydi.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase Storage (IVMS agent yuklaydigan bucket nomi) ---
VITE_IVMS_BUCKET=ivms-reports

# --- Xavfsiz login (ixtiyoriy) ---
# 'true' bo'lsa: custom login o'rniga Supabase Auth (email+parol) ishlatiladi.
# Bunda parollar bundle'ga tushmaydi (VITE_USERS kerak emas).
# Yoqishdan oldin Supabase -> Authentication da foydalanuvchilar yarating
# va schema.sql dagi "authenticated" RLS siyosatini yoqing (README ga qarang).
# Default (bo'sh yoki false) — hozirgi nickname+parol login ishlaydi.
VITE_SUPABASE_AUTH=false
